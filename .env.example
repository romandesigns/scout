# ============================================================
# Scout V6.5.0 — Historical Replay Calibration / Hostinger VPS
# Monitoring / decision support only. NO order placement.
# ============================================================

APP_ENV=production
APP_NAME=StockHunter Scout
APP_VERSION=6.5.0
APP_TIMEZONE=America/New_York
LOG_LEVEL=INFO

# ---------- Alpaca Algo Trader Plus ----------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=sip
ALPACA_MARKET_WS=wss://stream.data.alpaca.markets/v2/sip
# Algo Trader Plus can use BOATS for the 8 PM–4 AM ET overnight session.
ENABLE_OVERNIGHT_STREAM=true
ALPACA_OVERNIGHT_FEED=boats
ALPACA_OVERNIGHT_WS=wss://stream.data.alpaca.markets/v1beta1/boats
ALPACA_NEWS_WS=wss://stream.data.alpaca.markets/v1beta1/news
ALPACA_DATA_BASE=https://data.alpaca.markets
# Use the base URL that matches the key you use for /v2/assets.
ALPACA_TRADING_BASE=https://paper-api.alpaca.markets
# Scout Trader refuses any host other than paper-api.alpaca.markets. It is
# disabled by default and is activated only from the dashboard.

# Broad low-priced momentum universe. The daemon refreshes the eligible
# symbol set periodically and uses the paid SIP WebSocket for live trades.
MIN_PRICE=0.15
MAX_PRICE=10.00
UNIVERSE_REFRESH_SECONDS=60
UNIVERSE_MIN_PRICE=0.15
UNIVERSE_MAX_PRICE=10.00
UNIVERSE_BATCH_SIZE=200
UNIVERSE_MAX_SYMBOLS=12000
# Keep false unless load testing proves full-market wildcard is desirable.
WILDCARD_MARKET_STREAM=false

# ---------- Wake-up sensor ----------
BUCKET_SECONDS=15
WAKEUP_EVAL_SECONDS=15
BASELINE_BUCKETS=12
WARMUP_BUCKETS=8
WAKEUP_VOL_RATIO=4.0
FAST_VOL_RATIO=5.0
WAKEUP_PRICE_60S_PCT=2.0
FAST_PRICE_60S_PCT=1.5
EARLY_SCORE=6
IGNITION_SCORE=9
MAX_EARLY_EXTENSION_PCT=15.0
ALERT_COOLDOWN_SECONDS=180
FAST_PATH_MIN_INTERVAL_MS=750
KEEP_BUCKETS=160

# ---------- Bullish catalyst sensor ----------
# SEC automated access requires a descriptive User-Agent with contact info.
SEC_USER_AGENT=StockHunterScout/3.0 your-email@example.com
SEC_POLL_SECONDS=10
MIN_BULLISH_SCORE=3
# Optional direct RSS/Atom XML feed URLs, comma separated. Scout already has
# Alpaca News + SEC polling, so leaving this blank is recommended initially.
RSS_FEEDS=
# Optional comma-separated tickers you personally want prioritized. This does
# not restrict scanning; matching catalysts are boosted to score >=5.
# Example: CATALYST_WATCHLIST=WETO,STKH
CATALYST_WATCHLIST=
CATALYST_SOURCE_STALE_SECONDS=300

# Installed PWA background notifications. The coordinated VPS deploy creates
# persistent keys automatically when these values are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ---------- ntfy mobile push ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# If true, sends a second push containing the rendered chart image.
NTFY_CHART_FOLLOWUP=false

# ---------- Resend email ----------
RESEND_API_KEY=
RESEND_FROM=StockHunter Scout <alerts@YOUR_VERIFIED_DOMAIN.com>
RESEND_TO=your-email@example.com
EMAIL_EVERY_FINDING=true
NOTIFICATION_QUEUE_MAX=250
NTFY_MIN_INTERVAL_SECONDS=2
RESEND_MIN_INTERVAL_SECONDS=1
NOTIFICATION_RETRY_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=2
NOTIFICATION_RETRY_MAX_SECONDS=120


# ---------- V6.5 hybrid intelligence runtime ----------
# Rust is the frozen primary perception engine. Python remains the specialist
# context/lifecycle engine and contributes unique candidates.
HYBRID_ENABLED=true
RUST_PERCEPTION_BINARY=/usr/local/bin/scout-market-replay
RUST_BRIDGE_QUEUE_MAX=50000
HYBRID_MERGE_WINDOW_SECONDS=45
HYBRID_DEDUPE_SECONDS=20
HYBRID_EPISODE_GAP_SECONDS=900
# Notification-layer qualification only; does not alter Rust detection logic.
HYBRID_AWAKENING_MIN_VOL_RATIO=1.5
HYBRID_AWAKENING_MIN_CHANGE_15S_PCT=0.15
HYBRID_PRECISION_THRESHOLD_PCT=5.0

# ---------- Storage / health ----------
DATA_DIR=/data
CHART_DIR=/charts
HEALTH_PORT=8080

# ---------- Preserved V4 wake-up quality gates ----------
BASELINE_VOLUME_FLOOR=50
EARLY_MIN_CHANGE_60S_PCT=0.50
EARLY_MIN_EXTENSION_PCT=0.50
IGNITION_MIN_CHANGE_60S_PCT=1.50
IGNITION_MIN_EXTENSION_PCT=1.25
EMA_GAP_TOLERANCE_PCT=0.05
EMA_SLOPE_TOLERANCE_PCT=0.01
VWAP_TOLERANCE_PCT=0.20
MIN_30S_DOLLAR_VOLUME=1000
IGNITION_MIN_30S_DOLLAR_VOLUME=2500
MIN_30S_TRADES=3
IGNITION_MIN_30S_TRADES=5
REQUIRE_TWO_ACTIVE_BUCKETS=true

# Market quality gate: balanced, strict, or permissive. Developing/noisy
# activity remains visible in Scout but is silent until quality becomes CLEAN.
MARKET_QUALITY_PROFILE=balanced
QUALITY_WINDOW_BUCKETS=8
QUALITY_MIN_ACTIVE_RATIO=0.625
QUALITY_MIN_TRADES_30S=12
QUALITY_MIN_DOLLAR_30S=5000
QUALITY_MIN_DIRECTIONAL_EFFICIENCY=0.30
QUALITY_MAX_DIRECTION_REVERSALS=4
QUALITY_MAX_GAP_PCT=2.50
QUALITY_MAX_WICK_RATIO=5.0
QUALITY_MAX_STALE_SECONDS=30
QUALITY_IMPULSE_MIN_TRADES_15S=10
QUALITY_IMPULSE_MIN_DOLLAR_15S=5000
QUALITY_WATCH_COOLDOWN_SECONDS=120

# ---------- V5.6 first-leg initiation ----------
FIRST_LEG_BASE_BUCKETS=12
FIRST_LEG_MAX_BASE_RANGE_PCT=1.50
FIRST_LEG_MAX_EXTENSION_PCT=2.0
FIRST_LEG_MIN_VOL_RATIO=3.0
FIRST_LEG_MIN_CHANGE_3S_PCT=0.18
FIRST_LEG_MIN_CHANGE_5S_PCT=0.28
FIRST_LEG_MIN_CHANGE_15S_PCT=0.45
FIRST_LEG_MIN_DOLLAR_15S=2500
FIRST_LEG_MIN_TRADES_15S=8
FIRST_LEG_CONFIRMATION_SECONDS=3
FIRST_LEG_COOLDOWN_SECONDS=180
FIRST_LEG_NOTIFICATION_CONSOLIDATION_SECONDS=3
EARLY_MIN_CHANGE_15S_PCT=0.35
EARLY_MIN_CHANGE_30S_PCT=0.65
IGNITION_MIN_CHANGE_15S_PCT=0.85
IGNITION_MIN_CHANGE_30S_PCT=1.25
FAST_PRICE_15S_PCT=0.60
FAST_PRICE_30S_PCT=1.00
PRICE_ACCELERATION_MIN_PP=0.20
EARLY_MAX_BELOW_VWAP_PCT=0.75
FAST_SINGLE_BUCKET_VOL_RATIO=8.0
FAST_SINGLE_BUCKET_CHANGE_15S_PCT=0.60
FAST_SINGLE_BUCKET_DOLLAR_VOLUME=2500
FAST_SINGLE_BUCKET_TRADES=5
STAIRCASE_WINDOW_BUCKETS=8
STAIRCASE_MIN_ACTIVE_BUCKETS=5
STAIRCASE_MIN_CHANGE_PCT=1.00
STAIRCASE_MIN_UP_STEP_RATIO=0.60
STAIRCASE_MIN_HIGHER_LOW_RATIO=0.60
STAIRCASE_MIN_DOLLAR_VOLUME=4000
STAIRCASE_MIN_TRADES=8

# ---------- Scout dashboard / native clients ----------
# Leave empty for same-origin browser access. Add explicit origins for a
# separate Tauri/native client API origin, comma separated. Avoid * in production.
SCOUT_ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost,http://localhost:3000,http://127.0.0.1:3000
WEB_OUT_DIR=/srv/web-out

# ---------- V5 Surge / Breakout engines ----------
SURGE_MIN_CHANGE_3S_PCT=0.45
SURGE_MIN_CHANGE_5S_PCT=0.70
SURGE_MIN_CHANGE_10S_PCT=1.10
SURGE_MIN_CHANGE_15S_PCT=1.50
SURGE_MIN_VOL_RATIO=5.0
SURGE_MIN_DOLLAR_15S=2500
SURGE_MIN_TRADES_15S=5
BREAKOUT_MIN_PENETRATION_PCT=0.15
BREAKOUT_MIN_VOL_RATIO=3.0
BREAKOUT_MIN_DOLLAR_30S=1500
BREAKOUT_MIN_TRADES_30S=4
SIGNAL_STAGE_COOLDOWN_SECONDS=60
REARM_MIN_SECONDS=120
REARM_MIN_LEVEL_IMPROVEMENT_PCT=0.50
BREAKOUT_MIN_FRESH_VELOCITY_PCT=0.20
IGNITION_MIN_FRESH_VELOCITY_PCT=0.50
SURGE_WEAK_STRUCTURE_MIN_DOLLAR_15S=10000
SURGE_WEAK_STRUCTURE_MIN_TRADES_15S=20

# ---------- V5.5 reversal / reclaim episodes ----------
REVERSAL_LOOKBACK_BUCKETS=120
REVERSAL_LOW_WINDOW_BUCKETS=40
REVERSAL_MIN_DRAWDOWN_PCT=5.0
REVERSAL_WATCH_MIN_BOUNCE_PCT=0.75
REVERSAL_RECLAIM_MIN_BOUNCE_PCT=2.0
REVERSAL_MIN_VOL_RATIO=3.0
REVERSAL_MIN_DOLLAR_30S=5000
REVERSAL_MIN_TRADES_30S=12
REVERSAL_MIN_DOLLAR_15S=2500
REVERSAL_MIN_TRADES_15S=5
REVERSAL_MIN_VOL_RATIO_15S=1.5
REVERSAL_MAX_LOW_AGE_SECONDS=900
REVERSAL_EPISODE_COOLDOWN_SECONDS=300
REVERSAL_PULLBACK_MIN_PCT=0.75
REVERSAL_PULLBACK_MAX_PCT=6.0
REVERSAL_REARM_MIN_BOUNCE_PCT=0.35
NOTIFICATION_CONSOLIDATION_SECONDS=8
# Optional private dashboard/native deep-link base used by ntfy click actions.
# Example: https://scout.your-tailnet.ts.net
SCOUT_CLIENT_BASE_URL=https://srv1170872.tail86523.ts.net:8444
