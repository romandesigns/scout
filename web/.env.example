# Local Next.js development only.
# Leave unset for demo mode. To use the live VPS while developing locally,
# create an SSH tunnel to the private Scout API and set:
NEXT_PUBLIC_SCOUT_API_BASE=http://127.0.0.1:18081

# Docker/Self-hosted dashboard builds set this automatically.
# Tauri builds should leave it unset and provide NEXT_PUBLIC_SCOUT_API_BASE.
# NEXT_PUBLIC_SCOUT_SAME_ORIGIN=1
