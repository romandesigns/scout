{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockHunter Scout",
  "version": "6.6.9",
  "identifier": "io.wavystack.stockhunter.scout",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StockHunter Scout",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "dataDirectory": "native-v2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "stockhunter-scout",
          "scout"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "stockhunter-scout",
            "scout"
          ],
          "appLink": false
        }
      ]
    }
  }
}
